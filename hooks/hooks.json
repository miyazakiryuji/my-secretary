{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\""
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\""
          }
        ]
      }
    ]
  }
}
